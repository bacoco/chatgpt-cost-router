{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cost-router.invalid/schemas/request.schema.json",
  "title": "Request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "task": {
      "$ref": "common.schema.json#/$defs/task"
    },
    "capabilities": {
      "$ref": "common.schema.json#/$defs/manifest"
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/plan"
      },
      "minItems": 0
    }
  },
  "required": [
    "version",
    "task",
    "capabilities",
    "candidates"
  ]
}
