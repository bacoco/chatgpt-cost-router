{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cost-router.invalid/schemas/capabilities.schema.json",
  "title": "Capabilities",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/observation"
      },
      "minItems": 0
    }
  },
  "required": [
    "version",
    "manifest_id",
    "captured_at",
    "observations"
  ]
}
