{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cost-router.invalid/schemas/decision.schema.json",
  "title": "Decision",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "routed",
        "blocked"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "route": {
      "anyOf": [
        {
          "enum": [
            "CHAT",
            "SCHEDULED_CHAT",
            "LOCAL_TOOL",
            "CODEX",
            "WORK",
            "EXTERNAL_API",
            "HYBRID"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "selected_plan_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "cost_unit": {
      "const": "usd_micro"
    },
    "estimated_cost_units": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/plan"
        },
        {
          "type": "null"
        }
      ]
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "plan_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reasons": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "minItems": 1
          }
        },
        "required": [
          "plan_id",
          "reasons"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "version",
    "task_id",
    "evaluated_at",
    "policy_version",
    "policy_sha256",
    "status",
    "reason",
    "route",
    "selected_plan_id",
    "cost_unit",
    "estimated_cost_units",
    "plan",
    "rejected"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "route": {
            "type": "null"
          },
          "selected_plan_id": {
            "type": "null"
          },
          "estimated_cost_units": {
            "type": "null"
          },
          "plan": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "route": {
            "enum": [
              "CHAT",
              "SCHEDULED_CHAT",
              "LOCAL_TOOL",
              "CODEX",
              "WORK",
              "EXTERNAL_API",
              "HYBRID"
            ]
          },
          "selected_plan_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "estimated_cost_units": {
            "type": "integer",
            "minimum": 0
          },
          "plan": {
            "$ref": "common.schema.json#/$defs/plan"
          }
        }
      }
    }
  ]
}
